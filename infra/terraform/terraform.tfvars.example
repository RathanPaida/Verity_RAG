project_id      = "my-gcp-project"
region          = "us-central1"
gemini_backend  = "vertex" # or "api" to use a Gemini API key from Secret Manager
min_instances   = 0
max_instances   = 5
alert_email     = "oncall@example.com"
billing_account = "" # e.g. "000000-000000-000000" to enable the budget alert
