# MongoDB Atlas (Vector Search + Atlas Search need Atlas or the mongodb/mongodb-atlas-local image)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=verity

# Gemini backend: set GOOGLE_CLOUD_PROJECT to use Vertex AI (ADC auth: gcloud auth application-default login);
# leave it empty to use the Gemini Developer API with GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
GOOGLE_CLOUD_LOCATION=us-central1

# LLM: gemini | claude | fake (offline, deterministic heuristics)
LLM_PROVIDER=gemini
MODEL_FAST=gemini-3.8-flash
MODEL_STRONG=gemini-3.1-pro-preview
CLAUDE_MODEL=claude-opus-5-5

# Embeddings: gemini (Vertex or Developer API, same backend rule) | hash (offline).
# Changing provider/dim => rerun setup_db and re-ingest.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Retrieval tuning (compare with eval/run_eval.py after every change)
TOP_K=8
RRF_K=60
VECTOR_WEIGHT=1.0
TEXT_WEIGHT=1.0
CHUNK_TOKENS=350

# Agent budgets
MAX_REACT_STEPS=4
MAX_VERIFY_RETRIES=1
MAX_SUBQUESTIONS=4

# API auth (empty = disabled, local only)
VERITY_API_KEY=
# OTEL_EXPORTER=gcp
